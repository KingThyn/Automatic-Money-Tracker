import pandas as pd
from datetime import datetime
import json
from rich.console import Console
from rich.panel import Panel
import tkinter as tk
from tkinter import ttk, messagebox

'''Sesi Fungsi Hiasan CLI'''
console = Console()

def tampilkan_menu():
    menu_text = """[bold cyan]1.[/bold cyan] Masukan transaksi (Pemasukan/Pengeluaran)
[bold cyan]2.[/bold cyan] Cek Pengeluaran & Ringkasan saldo
[bold cyan]3.[/bold cyan] Cek Pemasukan
[bold yellow]4.[/bold yellow] Edit Transaksi
[bold red]5.[/bold red] Keluar dari Aplikasi"""
    
    menu_panel = Panel(
        menu_text, 
        title="[bold green]Money Tracker Sederhana[/bold green]", 
        expand=False, 
        border_style="yellow"
    )
    console.print(menu_panel)


'''===Sesi Fungsi Utama (Data & Logika)==='''
DATA_FILE = "data_transaksi.json"

def ornamen(garis="=" * 45):
    print(garis)

def muat_data():
    try:
        with open(DATA_FILE, "r") as f:
           return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
         return [] 
         
def simpan_data():
    with open(DATA_FILE, "w") as f:
        json.dump(daftar_transaksi, f, indent=4)
        
daftar_transaksi = muat_data()

def format_rupiah(nominal):
    return f"Rp {nominal:,.0f}".replace(',', '.')
    
def input_nominal(perintah):
    while True:
        try:
            nominal = float(console.input(perintah))
            if nominal <= 0:
                console.print("[bold red]Nominal harus lebih besar dari 0[/bold red]")
                continue
            return nominal
        except ValueError:
            console.print("[bold red]Input tidak valid! Harap masukan nominal yang valid[/bold red]")
            
def input_tanggal():
    hari_ini = datetime.now().strftime("%d-%m-%Y")
    tanggal = console.input(f"[bold yellow]Tanggal (DD-MM-YYYY) [Enter : {hari_ini}]: [/bold yellow]").strip()
    return hari_ini if not tanggal else tanggal

def tambah_transaksi():
    print("\n")
    console.rule("[bold blue]INPUT TRANSAKSI BARU[/bold blue]", style="blue")
    console.print("[cyan]1.[/cyan] Pemasukan(+)")
    console.print("[cyan]2.[/cyan] Pengeluaran(-)")
    console.print("[red]3.[/red] Kembali ke Menu Utama")
    
    pilihan = console.input("[bold magenta]Pilih jenis transaksi 1/2/3: [/bold magenta]").strip()
    if pilihan == "1":
        tipe = "Pemasukan"
    elif pilihan == "2":
        tipe = "Pengeluaran"
    elif pilihan == "3":
        return
    else:
        console.print("[bold red]Pilihan tidak valid[/bold red]")
        return
    
    keterangan_input = console.input("[bold yellow]Masukan keterangan transaksi: [/bold yellow]").strip()
    if not keterangan_input:
        keterangan_input = "Tanpa Keterangan"
        
    saldo = input_nominal(f"[bold yellow]Masukan nominal {tipe.lower()} (Rp): [/bold yellow]")
    tanggal = input_tanggal()
    
    transaksi = {
        "tipe": tipe,
        "keterangan": keterangan_input,
        "saldo": saldo,
        "tanggal": tanggal
    }
    
    daftar_transaksi.append(transaksi)
    simpan_data()
    console.print(f"\n[bold green]Berhasil mencatat {tipe.lower()} sebesar {format_rupiah(saldo)}![/bold green]")

def cek_pengeluaran():
    print("\n")
    console.rule("[bold blue]LAPORAN PENGELUARAN & SALDO[/bold blue]", style="blue")
    
    total_pengeluaran = sum(t["saldo"] for t in daftar_transaksi if t["tipe"] == "Pengeluaran")
    total_pemasukan = sum(t["saldo"] for t in daftar_transaksi if t["tipe"] == "Pemasukan")
    saldo_tersisa = total_pemasukan - total_pengeluaran 
    
    ringkasan_text = f"[bold green]Total Pemasukan[/bold green] : {format_rupiah(total_pemasukan)}\n" \
                     f"[bold red]Total Pengeluaran[/bold red] : {format_rupiah(total_pengeluaran)}\n" \
                     f"[bold cyan]Sisa Saldo[/bold cyan]        : {format_rupiah(saldo_tersisa)}"
    
    console.print(Panel(ringkasan_text, title="[bold yellow]Ringkasan Saldo[/bold yellow]", expand=False, border_style="cyan"))
    
    console.print("\n[bold magenta]--- DAFTAR DETAIL PENGELUARAN ---[/bold magenta]")
    riwayat_pengeluaran = [t for t in daftar_transaksi if t["tipe"] == "Pengeluaran"]
    
    if not riwayat_pengeluaran:
        console.print("[italic red](Belum ada catatan pengeluaran)[/italic red]")
    else:
        df = pd.DataFrame(riwayat_pengeluaran)
        df = df[['tanggal', 'keterangan', 'saldo']]
        df['saldo'] = df['saldo'].apply(lambda x: format_rupiah(x))
        df.insert(0, 'No', range(1, len(df) + 1))
        print(df.to_markdown(index=False, tablefmt="grid"))

def cek_pemasukan():
    print("\n")
    console.rule("[bold green]LAPORAN PEMASUKAN[/bold green]", style="green")
    
    console.print("\n[bold magenta]--- DAFTAR DETAIL PEMASUKAN ---[/bold magenta]")
    riwayat_pemasukan = [t for t in daftar_transaksi if t["tipe"] == "Pemasukan"]
    
    if not riwayat_pemasukan:
        console.print("[italic red](Belum ada catatan pemasukan)[/italic red]")
    else:
        df = pd.DataFrame(riwayat_pemasukan)
        df = df[['tanggal', 'keterangan', 'saldo']]
        df['saldo'] = df['saldo'].apply(lambda x: format_rupiah(x))
        df.insert(0, 'No', range(1, len(df) + 1))
        print(df.to_markdown(index=False, tablefmt="grid"))

def edit_transaksi():
    print("\n")
    console.rule("[bold yellow]EDIT TRANSAKSI[/bold yellow]", style="yellow")
    
    if not daftar_transaksi:
        console.print("[italic red](Belum ada data transaksi yang bisa diedit)[/italic red]")
        return
        
    df = pd.DataFrame(daftar_transaksi)
    df_display = df.copy()
    df_display['saldo'] = df_display['saldo'].apply(lambda x: format_rupiah(x))
    df_display.insert(0, 'ID', range(1, len(df_display) + 1)) 
    
    pd.set_option('display.max_rows', None)
    pd.set_option('display.colheader_justify', 'left')
    print(df_display.to_markdown(index=False, tablefmt="grid"))
    
    try:
        pilihan_id = int(console.input("\n[bold yellow]Masukan ID transaksi yang ingin diedit (ketik 0 untuk batal): [/bold yellow]"))
        if pilihan_id == 0:
            return
            
        if 1 <= pilihan_id <= len(daftar_transaksi):
            idx = pilihan_id - 1 
            transaksi = daftar_transaksi[idx]
            
            console.print(f"\n[bold cyan]Mengedit ID {pilihan_id}: {transaksi['tipe']} - {transaksi['keterangan']} ({format_rupiah(transaksi['saldo'])})[/bold cyan]")
            console.print("[cyan]1.[/cyan] Ubah Keterangan")
            console.print("[cyan]2.[/cyan] Ubah Nominal")
            console.print("[red]3.[/red] Batal Edit")
            
            aksi = console.input("[bold magenta]Pilih (1/2/3): [/bold magenta]").strip()
            
            if aksi == "1":
                keterangan_baru = console.input("[bold yellow]Masukan keterangan baru: [/bold yellow]").strip()
                if keterangan_baru:
                    daftar_transaksi[idx]['keterangan'] = keterangan_baru
                    simpan_data()
                    console.print("[bold green]Keterangan berhasil diperbarui![/bold green]")
            elif aksi == "2":
                nominal_baru = input_nominal("[bold yellow]Masukan nominal baru (Rp): [/bold yellow]")
                daftar_transaksi[idx]['saldo'] = nominal_baru
                simpan_data()
                console.print("[bold green]Nominal berhasil diperbarui![/bold green]")
            else:
                console.print("[bold red]Batal mengedit.[/bold red]")
        else:
            console.print("[bold red]ID tidak ditemukan![/bold red]")
    except ValueError:
        console.print("[bold red]Input harus berupa angka ID![/bold red]")


