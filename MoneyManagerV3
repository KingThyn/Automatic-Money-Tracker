'''===Program Runner (CLI)==='''
def main():
    while True:
        print("\n")
        tampilkan_menu() 
        pilihan = console.input("[bold magenta]Pilih menu (1-5): [/bold magenta]").strip()
        
        if pilihan == "1":
            tambah_transaksi() 
        elif pilihan == "2":
            cek_pengeluaran() 
        elif pilihan == "3":
            cek_pemasukan() 
        elif pilihan == "4":
            edit_transaksi()
        elif pilihan == "5":
            console.print("\n[bold green]Terimakasih telah menggunakan aplikasi kami![/bold green]")
            break 
        else:
            console.print("[bold red]Pilihan tidak valid![/bold red]")


'''===Entry Point (Sistem Routing)==='''
if __name__ == "__main__":
    try:
        while True:
            print("\n")
            console.rule("[bold magenta]PILIH MODE APLIKASI[/bold magenta]", style="magenta")
            console.print("[cyan]1.[/cyan] Terminal / CLI Mode (Rich UI)")
            console.print("[cyan]2.[/cyan] GUI Mode (Tkinter)")
            console.print("[red]3.[/red] Keluar")
            
            mode = console.input("\n[bold yellow]Pilih mode (1/2/3): [/bold yellow]").strip()
            
            if mode == "1":
                main()       # Masuk ke loop aplikasi terminal
                break        # Keluar dari loop pemilihan mode
            elif mode == "2":
                main_gui()   # Membuka jendela Tkinter
                break        # Keluar dari loop pemilihan mode setelah GUI ditutup
            elif mode == "3":
                console.print("\n[bold green]Sampai jumpa![/bold green]")
                break
            else:
                console.print("[bold red]Pilihan tidak valid. Silakan coba lagi.[/bold red]")
                
    except KeyboardInterrupt:
        console.print("\n[bold red]Program dibatalkan oleh pengguna. Sampai jumpa![/bold red]")